{
  "name": "animus",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "description": "Agent that produces narrated, research-grounded Manim explainer videos.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "format": "ultracite fix",
    "check": "ultracite check",
    "knip": "knip",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.2",
    "@vitest/coverage-v8": "3.2.6",
    "knip": "^6.35.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "ultracite": "^7.11.1",
    "vitest": "3.2.6"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
